{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Arjun0606/smolanalytics",
  "description": "End-to-end tests from one sentence: an agent drives a real browser, and passing runs replay free.",
  "repository": {
    "url": "https://github.com/Arjun0606/smolanalytics",
    "source": "github"
  },
  "version": "0.14.4",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/arjun0606/smolanalytics:v0.14.4",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "run the MCP server over stdio"
        }
      ]
    },
    {
      "registryType": "npm",
      "identifier": "smolanalytics",
      "version": "0.21.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "run the MCP server over stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "Your own Claude key. run_tests needs it for a test with no recording yet; a replay needs none.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "websiteUrl": "https://smolanalytics.com"
}
