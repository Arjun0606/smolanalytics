{
  "name": "smolanalytics",
  "version": "0.21.0",
  "description": "End-to-end tests without test code. Write one sentence, an agent drives a real browser and returns a verdict, and a passing run is recorded so the next one calls no model. Runs on any URL with no account.",
  "keywords": [
    "e2e-testing",
    "end-to-end-testing",
    "testing",
    "test-automation",
    "playwright",
    "qa",
    "ai-testing",
    "agentic-testing",
    "browser-testing",
    "regression-testing",
    "no-code-testing",
    "ci",
    "github-actions",
    "pull-request",
    "mcp",
    "cursor",
    "claude",
    "vibe-coding"
  ],
  "homepage": "https://smolanalytics.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arjun0606/smolanalytics.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/Arjun0606/smolanalytics/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "smolanalytics": "bin/smolanalytics.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=3 test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Arjun Varma"
}
